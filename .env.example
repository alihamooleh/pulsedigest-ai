# PulseDigest AI — copy to .env and fill in your keys
# --- Global LLM defaults (Live Model Discovery lets users override at runtime) ---
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_LLM_MODEL=openrouter/auto

# --- Cloud LLM provider API keys (only the one you use is required) ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
NVIDIA_NIM_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=

# --- External integrations (graceful degradation: empty means feature is skipped) ---
TAVILY_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
DISCORD_WEBHOOK_URL=

# --- App settings ---
DB_PATH=pulsedigest.db
HTTP_TIMEOUT_SECONDS=30
